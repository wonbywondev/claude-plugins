{
  "description": "skill-manager: dormant-skill nudge (UserPromptSubmit) + relations-ledger injection on skill invocation (PreToolUse).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/skill-aware.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/skill-routing.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
