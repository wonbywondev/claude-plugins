{
  "description": "skill-manager: nudge when a dormant (owned-but-unlinked) skill is named with use-intent.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/skill-aware.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
